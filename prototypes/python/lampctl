#!/usr/bin/env python3
"""Command-line client for lampd (stdlib only). Run `lampctl help`.

Env: LAMPD_URL (default http://127.0.0.1:8787), LAMPD_TOKEN (default ~/.config/lampd/token).
"""
import json
import os
import sys
import urllib.error
import urllib.request

URL = os.environ.get("LAMPD_URL", "http://127.0.0.1:8787").rstrip("/")
HELP = """lampctl <command>
  state                      current state
  on | off | toggle          power
  color <name|#hex|r,g,b> [brightness]
  brightness <1-100>
  effect <name|1-12> [speed]   built-in effects (rainbow, breathe, flash, or see `effects`)
  effects                    list built-in effects
  anim <name> [brightness]   play a library animation      stop    stop animation
  animations | presets       list library
  apply <preset>             apply a preset                save <preset>  save the current look
  play <file.json>           play an animation spec from a file without saving it
  put <name> <file.json>     save an animation spec to the library
  ops                        list raw protocol functions   raw <hex16>   send a raw frame
"""


def token():
    if os.environ.get("LAMPD_TOKEN"):
        return os.environ["LAMPD_TOKEN"]
    with open(os.path.expanduser("~/.config/lampd/token")) as f:
        return f.read().strip()


def call(method, path, data=None):
    req = urllib.request.Request(URL + path, method=method, headers={"Authorization": "Bearer " + token()},
                                 data=None if data is None else json.dumps(data).encode())
    if data is not None:
        req.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        sys.exit(f"error {e.code}: {json.load(e).get('error')}")
    except urllib.error.URLError as e:
        sys.exit(f"cannot reach lampd at {URL}: {e.reason}")


def color_arg(s):
    return [int(x) for x in s.split(",")] if "," in s else s


def main(argv):
    if not argv or argv[0] in ("help", "-h", "--help"):
        return print(HELP)
    c, a = argv[0], argv[1:]
    num = lambda i: float(a[i]) if len(a) > i else None  # noqa: E731
    if c == "state": out = call("GET", "/api/state")
    elif c == "on": out = call("POST", "/api/power", {"on": True})
    elif c == "off": out = call("POST", "/api/power", {"on": False})
    elif c == "toggle": out = call("POST", "/api/power", {})
    elif c == "color": out = call("POST", "/api/color", {"color": color_arg(a[0]), **({"brightness": num(1)} if num(1) else {})})
    elif c == "brightness": out = call("POST", "/api/brightness", {"value": num(0)})
    elif c == "effect": out = call("POST", "/api/effect", {"effect": int(a[0]) if a[0].isdigit() else a[0], **({"speed": num(1)} if num(1) else {})})
    elif c == "effects": out = call("GET", "/api/effects")
    elif c == "anim": out = call("POST", "/api/animation", {"name": a[0], **({"brightness": num(1)} if num(1) else {})})
    elif c == "stop": out = call("DELETE", "/api/animation")
    elif c == "animations": out = {k: v.get("description", "") for k, v in call("GET", "/api/animations").items()}
    elif c == "presets": out = {k: v.get("description", "") for k, v in call("GET", "/api/presets").items()}
    elif c == "apply": out = call("POST", f"/api/presets/{a[0]}/apply")
    elif c == "save": out = call("POST", f"/api/presets/{a[0]}/save-current")
    elif c == "play": out = call("POST", "/api/animation", {"spec": json.load(open(a[0]))})
    elif c == "put": out = call("PUT", f"/api/animations/{a[0]}", json.load(open(a[1])))
    elif c == "ops": out = call("GET", "/api/ops")
    elif c == "raw": out = call("POST", "/api/raw", {"hex": a[0]})
    else: return sys.exit(HELP)
    print(json.dumps(out, indent=None if c in ("state", "on", "off", "toggle") else 2))


if __name__ == "__main__":
    main(sys.argv[1:])
