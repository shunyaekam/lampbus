<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- launchd agent for the ambient creature. Installed by `deploy/install.sh --life`. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.lampbus.life</string>
  <key>ProgramArguments</key>
  <array><string>__HOME__/.local/bin/lampbus-life</string><string>--no-setup</string></array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>__HOME__/.local/bin:/usr/local/bin:/usr/bin:/bin</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/lampbus-life.log</string>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/lampbus-life.log</string>
</dict>
</plist>
